Always use sendLinuxNotificationDirect on Linux/BSD to ensure "--" is
passed before positional arguments, preventing titles that start with
a dash from being misinterpreted as flags by notify-send.

Without this, when notify-send doesn't support --replace-id (version < 0.8)
or when linuxGrouping is disabled, the code falls through to node-notifier's
NotifySend which doesn't insert "--" between flags and positional args.

--- a/src/notify.ts
+++ b/src/notify.ts
@@ -306,14 +306,11 @@
       return sendLinuxNotificationDirect(title, message, timeout, iconPath, false, () => onClick())
     }
 
-    if (linuxGrouping) {
-      if (linuxNotifySendSupportsReplace === null) {
-        linuxNotifySendSupportsReplace = await detectNotifySendCapabilities()
-      }
-      if (linuxNotifySendSupportsReplace) {
-        return sendLinuxNotificationDirect(title, message, timeout, iconPath, true)
-      }
+    if (linuxNotifySendSupportsReplace === null) {
+      linuxNotifySendSupportsReplace = await detectNotifySendCapabilities()
     }
+    const useGrouping = linuxGrouping && linuxNotifySendSupportsReplace
+    return sendLinuxNotificationDirect(title, message, timeout, iconPath, useGrouping)
   }
 
